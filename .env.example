# Configure either target or both. A command reads only the target it uses.

# DSM target
DSM_BASE_URL=https://nas.example.test:5001
DSM_USER=syno-agent
# DSM_PASSWORD_FILE=/path/to/dsm-password
# DSM_TOTP_SECRET_FILE=/path/to/dsm-totp

# SRM target. SRM commands work without any DSM_* variables.
# SRM_BASE_URL=https://router.example.test:8001
# SRM_USER=syno-agent
# SRM_PASSWORD_FILE=/path/to/srm-password
# SRM_TOTP_SECRET_FILE=/path/to/srm-totp

# Process settings
# AUDIT_LOG_DIR=~/.local/state/syno/audit
# TLS_REJECT_UNAUTHORIZED=0
